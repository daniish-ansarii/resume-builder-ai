PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_ORIGIN=http://localhost:5173

# Gemini API key. Keep this key on the server only.
GEMINI_API_KEY=
# Optional: defaults to gemini-3.8-flash.
# GEMINI_MODEL=gemini-3.8-flash
# Optional fast model for AI Enhance and resume imports; defaults to gemini-3.5-flash-lite.
# GEMINI_FAST_MODEL=gemini-3.5-flash-lite
# Optional faster model for resume imports; defaults to gemini-3.5-flash-lite.
# GEMINI_IMPORT_MODEL=gemini-3.5-flash-lite

# Optional: only needed for profile photo uploads and background removal.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL=

